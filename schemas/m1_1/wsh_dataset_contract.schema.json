{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WSH Dataset Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source_id",
    "dataset_key",
    "purpose",
    "source_url",
    "owner",
    "observation",
    "cadence",
    "fields",
    "extraction",
    "evidence",
    "validation",
    "retention"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
    },
    "source_id": {
      "$ref": "wsh_common_definitions.schema.json#/$defs/identifier"
    },
    "dataset_key": {
      "$ref": "wsh_common_definitions.schema.json#/$defs/identifier"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "consumers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "source_url": {
      "$ref": "wsh_common_definitions.schema.json#/$defs/url"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team_or_role"
      ],
      "properties": {
        "team_or_role": {
          "type": "string",
          "minLength": 1
        },
        "contact_reference": {
          "type": "string"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market_date_semantics",
        "timezone"
      ],
      "properties": {
        "market_date_semantics": {
          "type": "string"
        },
        "timezone": {
          "$ref": "wsh_common_definitions.schema.json#/$defs/timezone"
        },
        "source_timestamp_field": {
          "type": [
            "string",
            "null"
          ]
        },
        "capture_timestamp_required": {
          "type": "boolean"
        }
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_frequency",
        "calendar_policy"
      ],
      "properties": {
        "expected_frequency": {
          "type": "string"
        },
        "calendar_policy": {
          "type": "string"
        },
        "expected_publication_window": {
          "type": [
            "string",
            "null"
          ]
        },
        "late_publication_grace_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "native_name",
          "canonical_name",
          "data_type",
          "required"
        ],
        "properties": {
          "native_name": {
            "type": "string"
          },
          "canonical_name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "data_type": {
            "enum": [
              "string",
              "integer",
              "number",
              "boolean",
              "date",
              "datetime",
              "object",
              "array"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "currency": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string"
          },
          "nullable": {
            "type": "boolean"
          },
          "semantic_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "adapter_id"
      ],
      "properties": {
        "method": {
          "enum": [
            "http",
            "api",
            "browser",
            "download",
            "manual_evidence",
            "hybrid"
          ]
        },
        "adapter_id": {
          "$ref": "wsh_common_definitions.schema.json#/$defs/identifier"
        },
        "selectors_or_endpoint_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "authentication_required": {
          "type": "boolean"
        },
        "rate_limit_notes": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_capture_required",
        "capture_metadata_required",
        "hash_algorithm"
      ],
      "properties": {
        "raw_capture_required": {
          "type": "boolean"
        },
        "capture_metadata_required": {
          "type": "boolean"
        },
        "hash_algorithm": {
          "const": "SHA-256"
        },
        "allowed_media_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redaction_policy_reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_checks",
        "semantic_checks",
        "freshness_policy",
        "contamination_checks"
      ],
      "properties": {
        "schema_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "semantic_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "freshness_policy": {
          "type": "string"
        },
        "contamination_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reconciliation_rule": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_retention_policy",
        "normalized_retention_policy"
      ],
      "properties": {
        "raw_retention_policy": {
          "type": "string"
        },
        "normalized_retention_policy": {
          "type": "string"
        }
      }
    },
    "known_limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
